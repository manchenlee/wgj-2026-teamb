[node name="Section2Title" type="Label" parent="BookPanel/ContentContainer/VBoxContainer"]
layout_mode = 2
text = "什麼是安全詞？"
theme_override_colors/font_color = Color(0.35, 0.1, 0.05, 1)
theme_override_font_sizes/font_size = 20

[node name="Section2Body" type="Label" parent="BookPanel/ContentContainer/VBoxContainer"]
layout_mode = 2
text = "安全詞是 BDSM 活動中重要的溝通機制，當被動方瀕臨極限時喊出預定安全詞，支配方須立即停止。「同意式非同意」(CNC) 是在百分之百事前知情合意下進行的實踐，安全詞極為關鍵。請務必在開始前與夥伴充分溝通並確認安全詞（如「紅色」代表立刻停止），確保一切建立在知情與合意之上。"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.2, 0.1, 0.05, 1)
theme_override_font_sizes/font_size = 14

