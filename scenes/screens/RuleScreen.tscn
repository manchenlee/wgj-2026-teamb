[node name="Section1Body" type="Label" parent="BookPanel/ContentContainer/VBoxContainer"]
layout_mode = 2
text = "根據音樂符號出現的順序，透過鍵盤方向鍵提升生理興奮（紅色區域），同時以滑鼠點選對話提升情緒安撫（黃色區域）。將兩者同步維持在高水平，數值隨時間衰減，任一歸零即失敗，最終狀態影響結局。"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.2, 0.1, 0.05, 1)
theme_override_font_sizes/font_size = 14

