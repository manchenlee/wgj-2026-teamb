      "feedback_speakers": [
        "小提琴",
        "主角",
        "小提琴"
      ],
      "choice": [
        {
          "id": "option_1",
          "text": "（算了，既然本人都沒說甚麼，那就繼續吧。）",
          "effect": "negative"
        },
        {
          "id": "option_2",
          "text": "……你不說話，是希望我用猜的嗎？",
          "effect": "positive"
        }
